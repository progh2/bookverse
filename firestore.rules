rules_version = '2';

// 해커톤 MVP 범위의 규칙입니다. 학생은 Firebase Auth 없이 "전역 닉네임+PIN" 계정으로
// 로그인하므로, Firestore 규칙만으로는 "그 학생 본인"임을 완전히 검증할 수 없습니다.
// 1차 방어선(필수 필드·타입·길이 검증)만 두고, 실서비스 전환 시 Cloud Functions 기반
// PIN 검증 또는 커스텀 토큰 발급으로 교체가 필요합니다 (README '보안 한계' 참고).
service cloud.firestore {
  match /databases/{database}/documents {

    // 전역 학생 계정(로그인/회원가입). 닉네임으로 조회해야 하므로 list를 열어둔다 —
    // PIN 해시가 함께 노출되는 점은 해커톤 범위의 알려진 한계로 문서화한다.
    match /students/{accountId} {
      allow get: if true;
      allow list: if true;
      allow create: if isValidAccount(request.resource.data);
      allow update: if isValidAccount(request.resource.data);
      allow delete: if false;
    }

    // collectionGroup('books') 쿼리(학급 성운·게시판이 학급 전체 책을 한 번에 읽을 때 씀)는
    // 아래 classes/{code}/students/{id}/books/{id}의 중첩 match만으로는 허용되지 않는다 —
    // Firestore는 특정 부모 경로로 들어오는 접근과 "어디서든" 들어오는 collectionGroup 쿼리를
    // 다르게 취급하므로, 와일드카드 규칙을 별도로 둬야 collectionGroup 읽기가 통과한다.
    match /{path=**}/books/{bookId} {
      allow read: if true;
    }

    match /classes/{classCode} {
      allow get: if true; // 학급 코드 존재 확인 (학생 입장 시 필요)
      // 교사 관리자 페이지가 "내 학급 목록"을 where(teacherUid==내 uid)로 조회할 수 있게 허용.
      // teacherUid 조건 없이 전체 목록을 긁어가는 질의는 이 조건을 만족하지 못해 거부된다.
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow delete: if false;

      // OpenAI API 키 저장용 "쓰기 전용" 문서. 클라이언트는 절대 읽을 수 없고
      // (교사 본인도 다시 조회 불가 — 재입력으로만 교체), Cloud Functions의 Admin SDK만
      // 규칙을 우회해 읽어서 실제 AI 호출에 사용한다.
      match /secrets/{secretId} {
        allow read: if false;
        allow write: if isSignedIn()
          && get(/databases/$(database)/documents/classes/$(classCode)).data.teacherUid == request.auth.uid;
      }

      // 학급 멤버십(학생의 전역 계정과 문서 ID가 같다). 별자리 템플릿·별가루 등은 학급별로 따로 쌓인다.
      match /students/{studentId} {
        allow read: if true;
        allow create: if isValidMembership(request.resource.data);
        allow update: if isValidMembership(request.resource.data);
        allow delete: if isSignedIn(); // 교사 정리용 (해커톤 범위: uid 소유권 교차검증 생략)

        match /books/{bookId} {
          // read는 위쪽 /{path=**}/books/{bookId} 규칙이 담당(collectionGroup 쿼리까지 포괄).
          allow create: if isValidBook(request.resource.data);
          allow update: if isValidBook(request.resource.data);
          allow delete: if true;

          // 책 하나에 여러 개씩 다는 기록(문장·느낀점·요약·계기·탐구질문·다시읽음·필사 사진·의견).
          // 책 주인과 친구 모두 작성 가능. 고칠 때 작성자·종류는 못 바꾼다.
          match /entries/{entryId} {
            allow read: if true;
            allow create: if isValidEntry(request.resource.data);
            allow update: if isValidEntry(request.resource.data)
              && request.resource.data.authorId == resource.data.authorId
              && request.resource.data.type == resource.data.type;
            allow delete: if true;
          }

          // (구) 게시판 의견. entries의 'opinion'으로 옮긴 뒤로는 읽기만 남겨둔다.
          match /comments/{commentId} {
            allow read: if true;
            allow create, update: if false;
            allow delete: if true;
          }
        }
      }
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isValidAccount(data) {
    return data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
      && data.pinHash is string && data.pinHash.size() == 64
      && data.classCodes is list;
  }

  function isValidMembership(data) {
    return data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
      && data.constellationTemplate is string
      && data.starDust is number && data.starDust >= 0
      // 상점에서 쓴 별가루는 모은 별가루를 넘을 수 없다
      && (!('starDustSpent' in data) || (data.starDustSpent is number
          && data.starDustSpent >= 0 && data.starDustSpent <= data.starDust));
  }

  function isValidEntry(data) {
    return data.type in ['quote', 'reason', 'reread', 'summary', 'feeling', 'inquiry', 'photo', 'opinion']
      && data.text is string && data.text.size() <= 500
      // 필사 사진은 줄인 JPEG data URL로 문서 안에 담는다(문서 1MB 한도 안쪽)
      && (!('image' in data) || (data.type == 'photo' && data.image is string
          && data.image.size() <= 700000))
      && data.authorId is string && data.authorId.size() > 0
      && data.authorNickname is string && data.authorNickname.size() > 0 && data.authorNickname.size() <= 12
      && (!('page' in data) || (data.page is string && data.page.size() <= 20));
  }

  function isValidBook(data) {
    return data.title is string && data.title.size() > 0 && data.title.size() <= 80
      && data.author is string && data.author.size() > 0 && data.author.size() <= 40
      && data.rating is number && data.rating >= 1 && data.rating <= 5;
  }
}
