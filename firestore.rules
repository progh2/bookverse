rules_version = '2';

// 해커톤 MVP 범위의 규칙입니다. 학생은 Firebase Auth 없이 "학급코드+닉네임+PIN"으로
// 입장하므로(PRD 03탭), Firestore 규칙만으로는 "그 학생 본인"임을 완전히 검증할 수 없습니다.
// 1차 방어선(필수 필드·타입·길이 검증)만 두고, 실서비스 전환 시 Cloud Functions 기반
// PIN 검증 또는 커스텀 토큰 발급으로 교체가 필요합니다 (README '보안 한계' 참고).
service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{classCode} {
      allow get: if true; // 학급 코드 존재 확인 (학생 입장 시 필요)
      // 교사 관리자 페이지가 "내 학급 목록"을 where(teacherUid==내 uid)로 조회할 수 있게 허용.
      // teacherUid 조건 없이 전체 목록을 긁어가는 질의는 이 조건을 만족하지 못해 거부된다.
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow delete: if false;

      // OpenAI API 키 저장용 "쓰기 전용" 문서. 클라이언트는 절대 읽을 수 없고
      // (교사 본인도 다시 조회 불가 — 재입력으로만 교체), Cloud Functions의 Admin SDK만
      // 규칙을 우회해 읽어서 실제 AI 호출에 사용한다.
      match /secrets/{secretId} {
        allow read: if false;
        allow write: if isSignedIn()
          && get(/databases/$(database)/documents/classes/$(classCode)).data.teacherUid == request.auth.uid;
      }

      match /students/{studentId} {
        allow read: if true;
        allow create: if isValidStudent(request.resource.data);
        allow update: if isValidStudent(request.resource.data);
        allow delete: if isSignedIn(); // 교사 정리용 (해커톤 범위: uid 소유권 교차검증 생략)

        match /books/{bookId} {
          allow read: if true;
          allow create: if isValidBook(request.resource.data);
          allow update: if isValidBook(request.resource.data);
          allow delete: if true;
        }
      }
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isValidStudent(data) {
    return data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
      && data.pinHash is string && data.pinHash.size() == 64
      && data.starDust is number && data.starDust >= 0;
  }

  function isValidBook(data) {
    return data.title is string && data.title.size() > 0 && data.title.size() <= 80
      && data.author is string && data.author.size() > 0 && data.author.size() <= 40
      && data.rating is number && data.rating >= 1 && data.rating <= 5;
  }
}
